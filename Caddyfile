siberianlivecoding.ru {
    encode zstd gzip

    # Empty until at least one trusted device is enrolled. The activation
    # script creates an mTLS snippet here without changing this Caddyfile.
    import /etc/caddy/device-access/*.caddy

    handle_path /collab* {
        reverse_proxy realtime:1234
    }

    # Keep API traffic in a dedicated namespace so it can never fall through
    # to the frontend SPA and return index.html instead of JSON.
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
